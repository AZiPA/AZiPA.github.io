---
import type { Locale } from '../../config/ui.ts';
import { UI_COPY } from '../../config/ui.ts';
import { getProjectDocsUrl, type ProjectEntry } from '../../lib/projects.ts';
import StatusBadge from './StatusBadge.astro';

interface Props {
  project: ProjectEntry;
  lang: Locale;
}

const { project, lang } = Astro.props;
const { title, description, status, tags, repo } = project.data;
const docsUrl = getProjectDocsUrl(project, lang);
const copy = UI_COPY[lang].catalog;
---

<article class="az-card" data-tags={tags.join(',')}>
  <div class="az-card__inner">
    <header class="az-card__header">
      <h3 class="az-card__title">{title}</h3>
      <StatusBadge status={status} label={copy.statuses[status]} />
    </header>
    <p class="az-card__desc">{description}</p>
    <ul class="az-card__tags" role="list">
      {tags.map((tag) => (
        <li class="az-tag">{tag}</li>
      ))}
    </ul>
    {(docsUrl || repo) && (
      <footer class="az-card__actions">
        {docsUrl && (
          <a class="az-btn az-btn--primary" href={docsUrl} aria-label={`${copy.docsLink}: ${title}`}>
            {copy.docsLink}
          </a>
        )}
        {repo && (
          <a
            class="az-btn az-btn--secondary"
            href={repo}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${copy.githubLink}: ${title}`}
          >
            {copy.githubLink}
          </a>
        )}
      </footer>
    )}
  </div>
</article>

<style>
  .az-card {
    container: az-card / inline-size;
    background-color: var(--az-surface);
    border: 1px solid var(--az-border);
    border-radius: var(--az-radius-md);
    box-shadow: var(--az-shadow-card);
    min-inline-size: 0;
  }
  .az-card[hidden] {
    display: none;
  }
  .az-card__inner {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    block-size: 100%;
    padding: 1.25rem;
  }
  .az-card__header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .az-card__title {
    margin: 0;
    font-size: var(--sl-text-xl);
    font-weight: 600;
  }
  .az-card__desc {
    margin: 0;
    color: var(--az-text);
    font-size: var(--sl-text-sm);
  }
  .az-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .az-tag {
    padding-block: 0.1875rem;
    padding-inline: 0.5rem;
    border-radius: var(--az-radius-sm);
    border: 1px solid var(--az-border);
    background-color: var(--az-tag-bg);
    color: var(--az-text-muted);
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-2xs);
  }
  .az-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-block-start: auto;
    padding-block-start: 0.25rem;
  }
  @container az-card (inline-size >= 22rem) {
    .az-card__header {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
    }
  }
</style>
