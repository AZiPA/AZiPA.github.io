---
import { UI_COPY, type Locale } from '../../config/ui.ts';

interface Props {
  tags: string[];
  lang: Locale;
  controlsId: string;
}

const { tags, lang, controlsId } = Astro.props;
const copy = UI_COPY[lang].catalog;
const toolbarAttrs = { focusgroup: 'toolbar wrap' } as Record<string, string>;
---

<div
  class="az-filter-bar"
  role="toolbar"
  aria-label={copy.filterLabel}
  aria-controls={controlsId}
  data-az-filter-toolbar
  {...toolbarAttrs}
>
  <button type="button" class="az-filter-btn" data-tag="all" aria-pressed="true">
    {copy.allTag}
  </button>
  {tags.map((tag) => (
    <button type="button" class="az-filter-btn" data-tag={tag} aria-pressed="false">
      {tag}
    </button>
  ))}
</div>

<style>
  .az-filter-bar {
    display: flex;
    flex-wrap: wrap;
    flex-wrap: balance;
    gap: 0.5rem;
  }

  .az-filter-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 2.5rem;
    min-block-size: 2.25rem;
    padding-block: 0.375rem;
    padding-inline: 0.875rem;
    border: 1px solid var(--az-border);
    border-radius: var(--az-radius-pill);
    background-color: var(--az-surface);
    color: var(--az-text);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    cursor: pointer;
  }

  .az-filter-btn[aria-pressed='true'] {
    background-color: var(--az-accent-soft);
    border-color: var(--az-accent);
    color: var(--az-text-strong);
    font-weight: 600;
  }

  .az-filter-btn:focus-visible {
    outline: 2px solid var(--az-focus-ring);
    outline-offset: 2px;
  }

  @media (pointer: coarse) {
    .az-filter-btn {
      min-block-size: 2.75rem;
      padding-inline: 1rem;
    }
  }

  @media (hover: hover) {
    .az-filter-btn:hover {
      border-color: var(--az-border-strong);
      background-color: var(--az-surface-hover);
    }
  }

  @media (forced-colors: active) {
    .az-filter-btn[aria-pressed='true'] {
      background-color: Highlight;
      color: HighlightText;
      border-color: ButtonText;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .az-filter-btn {
      transition: background-color 0.15s ease, border-color 0.15s ease;
    }
  }
</style>
